# Salin ke .env untuk pengembangan lokal. Jangan commit .env.
# Pilih mode dengan modul Uvicorn: main:app atau main_supabase:app.

# MODE 1 - VPS / filesystem lokal (main.py)
DREAMPALM_STORAGE_ROOT=./storage
DREAMPALM_MEDIA_BASE=/api/media
# Pada VPS, systemd menetapkan root: /srv/dreampalm-storage/uji

# MODE 2 - Supabase (main_supabase.py)
# Isi URL dan key hanya jika menjalankan mode Supabase.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=snapshots